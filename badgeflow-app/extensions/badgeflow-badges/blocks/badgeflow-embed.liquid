{%- comment -%}
  BadgeFlow app embed. Outputs the shop's live/scheduled campaigns (synced by
  the app into an app-owned metafield) and loads badgeflow.js, which draws the
  badges on product cards and the product page. Renders nothing when the app
  is switched off in BadgeFlow settings, except a sample in the theme editor.
{%- endcomment -%}
{%- assign bf_config = app.metafields.badgeflow.config.value -%}
{%- assign bf_enabled = true -%}
{%- if bf_config and bf_config.enabled == false -%}
  {%- assign bf_enabled = false -%}
{%- endif -%}

{%- comment -%} Smart badges (automatic sale / new) need prices and publish dates. {%- endcomment -%}
{%- assign bf_smart = false -%}
{%- if bf_config -%}
  {%- for bf_c in bf_config.campaigns -%}
    {%- if bf_c.kind == 'sale' or bf_c.kind == 'new' -%}{%- assign bf_smart = true -%}{%- break -%}{%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- if bf_enabled or request.design_mode -%}
  <script type="application/json" id="badgeflow-config">{{ app.metafields.badgeflow.config.value | json }}</script>
  <script type="application/json" id="badgeflow-context">
    {
      "designMode": {{ request.design_mode | json }},
      "showSample": {{ block.settings.show_sample | json }},
      "productHandle": {% if template.name == 'product' and product %}{{ product.handle | json }}{% else %}null{% endif %},
      "productAvailable": {% if template.name == 'product' and product %}{{ product.available | json }}{% else %}null{% endif %},
      "currency": {{ cart.currency.iso_code | json }},
      "moneyFormat": {{ shop.money_format | strip_html | json }},
      "availability": {
        {%- comment -%}
          Availability for the first products of this collection or search, so
          most cards need no lookup. Cards beyond these (later pages, infinite
          scroll, other sections) are checked by badgeflow.js.
        {%- endcomment -%}
        {%- assign bf_first = true -%}
        {%- if template.name == 'collection' and collection -%}
          {%- for p in collection.products limit: 50 -%}
            {%- unless bf_first -%},{%- endunless -%}{{ p.handle | json }}:{{ p.available | json }}{%- assign bf_first = false -%}
          {%- endfor -%}
        {%- elsif template.name == 'search' and search.performed -%}
          {%- for item in search.results limit: 50 -%}
            {%- if item.object_type == 'product' -%}
              {%- unless bf_first -%},{%- endunless -%}{{ item.handle | json }}:{{ item.available | json }}{%- assign bf_first = false -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      }
      {%- if bf_smart -%},
      "products": {
        {%- assign bf_first = true -%}
        {%- if template.name == 'product' and product -%}
          {%- render 'badgeflow-product-seed', p: product -%}{%- assign bf_first = false -%}
        {%- elsif template.name == 'collection' and collection -%}
          {%- for p in collection.products limit: 50 -%}
            {%- unless bf_first -%},{%- endunless -%}{%- render 'badgeflow-product-seed', p: p -%}{%- assign bf_first = false -%}
          {%- endfor -%}
        {%- elsif template.name == 'search' and search.performed -%}
          {%- for item in search.results limit: 50 -%}
            {%- if item.object_type == 'product' -%}
              {%- unless bf_first -%},{%- endunless -%}{%- render 'badgeflow-product-seed', p: item -%}{%- assign bf_first = false -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      }
      {%- endif %}
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "BadgeFlow badges",
  "target": "body",
  "javascript": "badgeflow.js",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_sample",
      "label": "Show a sample badge in the theme editor",
      "info": "Only visible while editing your theme, and only when no campaign is live.",
      "default": true
    }
  ]
}
{% endschema %}
